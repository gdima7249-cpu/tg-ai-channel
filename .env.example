# Токен бота от @BotFather. Бота нужно добавить в канал администратором с правом публиковать.
TG_BOT_TOKEN=
# Ваш канал: @username или числовой id вида -100...
TG_CHANNEL=
# Режим одобрения: если указать здесь свой chat id (узнать: @userinfobot), посты приходят вам в личку
# черновиками с кнопками «Опубликовать» / «Отклонить» (нужна служба tgchannel-bot, см. INSTALL.md).
# Пустое значение — посты сразу уходят в канал.
TG_PREVIEW_CHAT=
# Ключ Gemini API: https://aistudio.google.com/apikey (подписка Gemini в приложении сюда не подходит)
GEMINI_API_KEY=
# Модели по очереди, через запятую: если одна перегружена или снята, берётся следующая
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# Подпись в конце каждого поста, например: @my_channel
CHANNEL_SIGNATURE=
# Тон канала (свободным текстом, уходит в инструкцию для модели)
CHANNEL_STYLE=Канал про игры и мемы. Пишем по-русски, живо, коротко, с иронией, без канцелярита. Эмодзи уместно, но не больше 2–3.
